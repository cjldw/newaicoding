# 旗程后端配置示例 (复制为 .env 并填入真实值)
DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/aicoding?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
PLATFORM_SECRET_KEY=your-32-byte-hex-key-for-aes-256-gcm
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
